{
  "name": "flytripvisa",
  "version": "1.0.0",
  "description": "FlyTripVisa - AI Powered Visa, Flights, Hotels & eSIM platform on Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute flytripvisa-db --file=./schema.sql --local",
    "db:init:remote": "wrangler d1 execute flytripvisa-db --file=./schema.sql --remote",
    "types": "wrangler types",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20250313.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.0"
  },
  "dependencies": {
    "agents": "^0.0.40"
  }
}
